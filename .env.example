# Copy to .env (never commit .env). All secrets stay server-side.
PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=
TPDB_API_KEY=
TORBOX_API_KEY=

# Optional
PORT=8787
# Public base URL the app is reached at (used to build the pCloud redirect_uri), e.g. https://pulse.example.com
PUBLIC_URL=
# 32+ char random string used to encrypt tokens at rest. Auto-generated into data/.app-key if empty.
APP_SECRET=
# Where sqlite + keys live
DATA_DIR=./data
# Device pairing code required to open the app from a new device. Auto-generated into data/access-code if empty.
ACCESS_CODE=
