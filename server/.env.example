# Copy to .env (never commit real values). The server also reads these from the process environment.
PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=
TPDB_API_KEY=
# Optional second metadata source (StashDB): API key from your StashDB account settings
STASHDB_API_KEY=
TORBOX_API_KEY=
# How many files from inside a TorBox zip are copied to pCloud at the same time (streamed through this server, never stored). Default 2.
# TORBOX_TRANSFER_CONCURRENCY=2
# Metadata providers blocked on your network? (docs/hosting.md, "Provider proxy")
# Endpoints (defaults shown); DNS-over-HTTPS fallback is automatic (PROVIDER_DOH=0 disables)
TPDB_BASE_URL=
STASHDB_URL=
# Optional Cloudflare Worker (docs/cloudflare-proxy-worker.js) that forwards provider calls
PROVIDER_PROXY_URL=
PROVIDER_PROXY_SECRET=
# Matching speed (all optional, defaults shown). Request rate adapts automatically (backs off on HTTP 429, honours Retry-After / X-RateLimit-*).
# MATCH_CONCURRENCY=10
# TPDB_MAX_RPS=10
# TPDB_START_RPS=8
# MATCH_FALLBACK_BUDGET=16
# SCAN_CONCURRENCY=6
# Optional
PORT=8787
HOST=0.0.0.0
# Public base URL used to build the pCloud redirect URI, e.g. https://pulse.example.com
PUBLIC_BASE_URL=
# Optional 32+ char secret used to encrypt tokens at rest (otherwise data/secret.key is generated)
PULSE_SECRET=
# App PIN (4-8 digits). Default is 6442 when unset and no PIN is stored. Applied at startup whenever this value changes;
# you can also change the PIN in Settings > Privacy.
APP_PIN=
DATA_DIR=./data
WEB_DIST=../web/dist
